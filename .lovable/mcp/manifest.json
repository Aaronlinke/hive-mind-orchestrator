{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rmhnmvbnvyssnampsjhd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hive-mind-orchestrator",
      "version": "0.1.0",
      "title": "hive-mind-orchestrator"
    },
    "tools": [
      {
        "name": "list_chat_sessions",
        "title": "List chat sessions",
        "description": "List the signed-in user's saved orchestrator chat sessions, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Max sessions to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_chat_messages",
        "title": "Get chat messages",
        "description": "Read messages of one of the signed-in user's chat sessions in chronological order.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Chat session ID from list_chat_sessions."
            },
            "limit": {
              "default": 50,
              "description": "Max messages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_knowledge",
        "title": "Search knowledge base",
        "description": "Search the Nexus knowledge base (formulas, science, tech notes) by keyword in title or content.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Keyword, e.g. 'entropy' or 'SHA256'."
            },
            "limit": {
              "default": 10,
              "description": "Max entries to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
